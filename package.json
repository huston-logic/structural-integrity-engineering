{
  "name": "site-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4821",
    "build": "next build",
    "build:launch": "npm run check:config && npm run check:placeholders && next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "check:placeholders": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-placeholders.mjs",
    "sync:config": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-config.mjs",
    "check:config": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-config.mjs --check",
    "check:scope": "node scripts/check-change-scope.mjs",
    "report:changes": "node scripts/change-report.mjs",
    "strip:images": "node scripts/strip-image-metadata.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"worker/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun",
    "check": "npm run check:config && npm run lint && npm run typecheck && npm run test:worker && npm run test:scripts && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "wrangler": "4.160.1"
  },
  "overrides": {
    "playwright-core": "1.65.0",
    "basic-ftp": "6.2.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1",
      "@isaacs/nonrecursive-glob-match": "1.0.3"
    }
  },
  "description": "Structural Integrity Engineering website (static export for Cloudflare Workers).",
  "engines": {
    "node": ">=22.19",
    "npm": ">=10.9.2 <11"
  }
}
